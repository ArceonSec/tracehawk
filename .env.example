# ─────────────────────────────────────────────────────────────
# tracehawk — environment variables template
# Copy this file to .env and fill in real values.
# .env is git-ignored and docker-ignored — never commit it.
# ─────────────────────────────────────────────────────────────

# Required: Token used to authenticate every request to the tracehawk API.
# Use a long random string — e.g. `openssl rand -hex 32`
TRACEHAWK_API_KEY=changeme-use-openssl-rand-hex-32

# Required: Google Gemini API key for AI-powered remediation suggestions.
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
